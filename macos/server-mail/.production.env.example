# Copy to .production.env only after a domain and provider accounts exist.
# Keep this file free of secrets; secret values live as mode-0600 files in .runtime/.
ROOT_DOMAIN=example.com
MAIL_PRODUCTION_ENABLED=1
SENDING_DOMAIN=news.example.com
PUBLIC_HOST=mail.example.com
FROM_NAME="Example Fuar Ekibi"
FROM_ADDRESS=fuar@news.example.com
REPLY_TO_ADDRESS=hello@example.com
LEGAL_FOOTER="Example Şirket · açık posta adresi · şehir · ülke"
BREVO_SMTP_USER=your-brevo-smtp-login
DKIM_SELECTOR=mail
BREVO_API_KEY_FILE=./.runtime/brevo-api-key
BREVO_SMTP_KEY_FILE=./.runtime/brevo-smtp-key
LISTMONK_BOUNCE_USER=brevo-bounce
LISTMONK_BOUNCE_TOKEN_FILE=./.runtime/listmonk-bounce-token
CLOUDFLARE_TUNNEL_TOKEN_FILE=./.runtime/cloudflare-tunnel-token
CONSENT_LEDGER=./.runtime/consent-ledger.csv
